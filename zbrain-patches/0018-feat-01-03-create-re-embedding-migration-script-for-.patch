@@ -0,0 +1,303 @@
+#!/usr/bin/env python3
+"""
+One-time migration: Re-embed all existing Promaia content with gemini-embedding-001.
+
+Reads content from Promaia's Postgres content tables and generates new embeddings
+using gemini-embedding-001 (768 dims) stored in the content_embeddings table via pgvector.
+
+Usage:
+    python scripts/migrate_embeddings.py              # Run migration
+    python scripts/migrate_embeddings.py --dry-run    # Count items only
+    python scripts/migrate_embeddings.py --force      # Re-embed everything
+    python scripts/migrate_embeddings.py --delay 0.2  # Custom delay between API calls
+"""
+import argparse
+import time
+import sys
+import os
+import logging
+
+# Add project root to path
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from promaia.storage.postgres_db import get_postgres_db
+from promaia.storage.vector_db import VectorDBManager
+
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s [%(levelname)s] %(message)s",
+    datefmt="%H:%M:%S",
+)
+logger = logging.getLogger(__name__)
+
+
+# Table mapping: (table_name, page_id_column, content_column, workspace_column)
+# Derived from schema.sql -- each content table with its relevant columns
+CONTENT_TABLES = [
+    {
+        "table": "content_items",
+        "page_id": "id",          # SERIAL primary key, cast to TEXT for page_id
+        "content": "content",
+        "workspace": None,        # content_items uses source_name, not workspace
+        "extra_meta": ["source_name", "content_type", "title"],
+    },
+    {
+        "table": "gmail_content",
+        "page_id": "page_id",
+        "content": "message_content",
+        "workspace": "workspace",
+        "extra_meta": ["subject", "sender_email", "thread_id"],
+    },
+    {
+        "table": "notion_journal",
+        "page_id": "page_id",
+        "content": "title",       # Journal entries may only have title
+        "workspace": "workspace",
+        "extra_meta": ["database_name", "status", "date_value"],
+    },
+    {
+        "table": "notion_stories",
+        "page_id": "page_id",
+        "content": "title",       # Stories may only have title
+        "workspace": "workspace",
+        "extra_meta": ["database_name", "status", "priority"],
+    },
+    {
+        "table": "notion_cms",
+        "page_id": "page_id",
+        "content": "title",       # CMS entries may only have title
+        "workspace": "workspace",
+        "extra_meta": ["database_name", "status", "category"],
+    },
+    {
+        "table": "generic_content",
+        "page_id": "page_id",
+        "content": "title",       # Generic content uses title
+        "workspace": "workspace",
+        "extra_meta": ["database_name", "content_type"],
+    },
+]
+
+
+def table_exists(db, table_name: str) -> bool:
+    """Check if a table exists in the database."""
+    try:
+        return db.table_exists(table_name)
+    except Exception:
+        return False
+
+
+def get_row_count(db, table_name: str, content_column: str) -> int:
+    """Get count of rows with non-null, non-empty content in a table."""
+    try:
+        result = db.fetch_one(
+            f"SELECT COUNT(*) as cnt FROM {table_name} "
+            f"WHERE {content_column} IS NOT NULL AND {content_column} != ''",
+        )
+        return result["cnt"] if result else 0
+    except Exception as e:
+        logger.warning(f"Could not count rows in {table_name}: {e}")
+        return 0
+
+
+def migrate_table(
+    table_config: dict,
+    vdb: VectorDBManager,
+    dry_run: bool = False,
+    force: bool = False,
+    delay: float = 0.1,
+) -> dict:
+    """
+    Migrate embeddings from a single content table.
+
+    Returns dict with stats: total, embedded, skipped, errors
+    """
+    table_name = table_config["table"]
+    page_id_col = table_config["page_id"]
+    content_col = table_config["content"]
+    workspace_col = table_config["workspace"]
+    extra_meta_cols = table_config.get("extra_meta", [])
+
+    db = get_postgres_db()
+
+    # Check if table exists
+    if not table_exists(db, table_name):
+        logger.info(f"  Table '{table_name}' does not exist, skipping")
+        return {"total": 0, "embedded": 0, "skipped": 0, "errors": 0}
+
+    # Build SELECT query with all needed columns
+    select_cols = [page_id_col, content_col]
+    if workspace_col:
+        select_cols.append(workspace_col)
+    for col in extra_meta_cols:
+        select_cols.append(col)
+
+    col_list = ", ".join(select_cols)
+    query = (
+        f"SELECT {col_list} FROM {table_name} "
+        f"WHERE {content_col} IS NOT NULL AND {content_col} != ''"
+    )
+
+    try:
+        rows = db.fetch_all(query)
+    except Exception as e:
+        logger.error(f"  Failed to query {table_name}: {e}")
+        return {"total": 0, "embedded": 0, "skipped": 0, "errors": 1}
+
+    total = len(rows)
+    embedded = 0
+    skipped = 0
+    errors = 0
+
+    if total == 0:
+        logger.info(f"  {table_name}: 0 items with content")
+        return {"total": 0, "embedded": 0, "skipped": 0, "errors": 0}
+
+    logger.info(f"  {table_name}: {total} items with content")
+
+    for i, row in enumerate(rows):
+        page_id = str(row[page_id_col])
+        content = row[content_col]
+
+        # Check if embedding already exists (idempotent -- skip if present)
+        if not force:
+            try:
+                if vdb.check_exists(page_id):
+                    skipped += 1
+                    continue
+            except Exception:
+                pass  # If check fails, try to embed anyway
+
+        if dry_run:
+            embedded += 1
+            if (i + 1) % 50 == 0 or (i + 1) == total:
+                logger.info(f"  [dry-run] {table_name}: {i + 1}/{total}")
+            continue
+
+        # Build metadata
+        metadata = {"source_table": table_name}
+        if workspace_col and row.get(workspace_col):
+            metadata["workspace"] = row[workspace_col]
+        for col in extra_meta_cols:
+            val = row.get(col)
+            if val is not None:
+                if isinstance(val, (str, int, float, bool)):
+                    metadata[col] = val
+                elif isinstance(val, (list, dict)):
+                    metadata[col] = val
+
+        try:
+            success = vdb.add_content(page_id, content, metadata)
+            if success:
+                embedded += 1
+            else:
+                errors += 1
+
+            # Rate limiting
+            if delay > 0:
+                time.sleep(delay)
+
+            # Progress logging
+            if (i + 1) % 10 == 0 or (i + 1) == total:
+                logger.info(
+                    f"  {table_name}: Embedded {embedded}/{i + 1} "
+                    f"(skipped {skipped}, errors {errors})"
+                )
+        except Exception as e:
+            logger.error(f"  Error embedding {page_id} from {table_name}: {e}")
+            errors += 1
+
+    return {"total": total, "embedded": embedded, "skipped": skipped, "errors": errors}
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Re-embed all existing Promaia content with gemini-embedding-001"
+    )
+    parser.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="Count items that would be embedded without calling the API",
+    )
+    parser.add_argument(
+        "--force",
+        action="store_true",
+        help="Re-embed everything even if embeddings already exist",
+    )
+    parser.add_argument(
+        "--delay",
+        type=float,
+        default=0.1,
+        help="Delay in seconds between embedding API calls (default: 0.1)",
+    )
+    args = parser.parse_args()
+
+    mode = "DRY RUN" if args.dry_run else ("FORCE" if args.force else "NORMAL")
+    logger.info(f"=== Promaia Embedding Migration ({mode}) ===")
+    logger.info(f"Embedding model: gemini-embedding-001 (768 dims)")
+    logger.info(f"Target table: content_embeddings (pgvector)")
+    logger.info(f"API delay: {args.delay}s between calls")
+    logger.info("")
+
+    # Initialize VectorDBManager (connects to Supabase, validates API key)
+    try:
+        vdb = VectorDBManager()
+        logger.info(f"VectorDBManager initialized: {vdb.embedding_model}")
+    except Exception as e:
+        logger.error(f"Failed to initialize VectorDBManager: {e}")
+        logger.error("Make sure GOOGLE_API_KEY and DATABASE_URL are set in .env")
+        sys.exit(1)
+
+    # Get pre-migration stats
+    pre_stats = vdb.get_stats()
+    logger.info(f"Pre-migration stats: {pre_stats.get('total_documents', 0)} content embeddings, "
+                f"{pre_stats.get('total_property_embeddings', 0)} property embeddings")
+    logger.info("")
+
+    # Migrate each content table
+    grand_total = 0
+    grand_embedded = 0
+    grand_skipped = 0
+    grand_errors = 0
+
+    for table_config in CONTENT_TABLES:
+        logger.info(f"Processing: {table_config['table']}")
+        stats = migrate_table(
+            table_config,
+            vdb,
+            dry_run=args.dry_run,
+            force=args.force,
+            delay=args.delay,
+        )
+        grand_total += stats["total"]
+        grand_embedded += stats["embedded"]
+        grand_skipped += stats["skipped"]
+        grand_errors += stats["errors"]
+        logger.info("")
+
+    # Summary
+    logger.info("=== Migration Summary ===")
+    logger.info(f"Total items found: {grand_total}")
+    logger.info(f"Embedded: {grand_embedded}")
+    logger.info(f"Skipped (already exist): {grand_skipped}")
+    logger.info(f"Errors: {grand_errors}")
+
+    if args.dry_run:
+        logger.info(f"\n[DRY RUN] Would embed {grand_embedded} items. "
+                     "Run without --dry-run to execute.")
+    else:
+        # Get post-migration stats
+        post_stats = vdb.get_stats()
+        logger.info(f"\nPost-migration stats: {post_stats.get('total_documents', 0)} content embeddings, "
+                    f"{post_stats.get('total_property_embeddings', 0)} property embeddings")
+
+    if grand_total == 0:
+        logger.info("\nNo content found in any tables -- this is expected if no sync "
+                     "has been run against the new Supabase project yet.")
+        logger.info("Run a content sync first, then re-run this migration script.")
+
+    logger.info("\nDone.")
+
+
+if __name__ == "__main__":
+    main()
