+/*
+ * Data Temple — Ryoji Ikeda
+ * Data as art. Barcode rhythm, electronic pulse.
+ * Pure black, matrix green, scan blue, signal red.
+ * Everything in monospace. The terminal is the temple.
+ */
+
+:root {
+    /* Fonts — all monospace */
+    --font-display: 'JetBrains Mono', monospace;
+    --font-heading: 'JetBrains Mono', monospace;
+    --font-body: 'JetBrains Mono', monospace;
+    --font-mono: 'JetBrains Mono', monospace;
+
+    /* Colors */
+    --bg-primary: #000000;
+    --bg-secondary: #0A0A0A;
+    --bg-card: #0F0F0F;
+    --bg-card-hover: #161616;
+    --text-primary: #E0E0E0;
+    --text-secondary: #888888;
+    --text-muted: #555555;
+    --accent-primary: #00FF41;
+    --accent-success: #00FF41;
+    --accent-warning: #FF0040;
+    --accent-info: #0088FF;
+    --border-subtle: #1A1A1A;
+    --border-visible: #2A2A2A;
+
+    /* Spacing */
+    --space-xs: 4px;
+    --space-sm: 8px;
+    --space-md: 16px;
+    --space-lg: 24px;
+    --space-xl: 32px;
+    --space-2xl: 48px;
+
+    /* Radius — sharp, geometric */
+    --radius-sm: 2px;
+    --radius-md: 4px;
+    --radius-lg: 6px;
+
+    /* Transitions — snappy */
+    --transition-fast: 100ms linear;
+    --transition-normal: 200ms linear;
+}
+
+/* Scan-line overlay */
+body::after {
+    content: '';
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    pointer-events: none;
+    z-index: 999;
+    background: repeating-linear-gradient(
+        0deg,
+        transparent,
+        transparent 2px,
+        rgba(0, 255, 65, 0.015) 2px,
+        rgba(0, 255, 65, 0.015) 4px
+    );
+}
+
+/* Cards: data panels */
+.card {
+    box-shadow: none;
+    border-color: #1A1A1A;
+}
+
+.card:hover {
+    border-color: #00FF41;
+    box-shadow: 0 0 12px rgba(0, 255, 65, 0.06);
+    transform: translateY(0);
+}
+
+.card--accent {
+    border-left-color: #00FF41;
+}
+
+/* Greeting: terminal prompt feel */
+.greeting {
+    font-weight: 400;
+    font-size: clamp(1.4rem, 3vw, 2rem);
+    color: #00FF41;
+}
+
+.header-date {
+    color: #555555;
+}
+
+/* Brain status: bright data readout */
+.brain-status .metric {
+    color: #00FF41;
+    font-weight: 400;
+}
+
+.brain-status__sep {
+    color: #333333;
+}
+
+/* Section headers: terminal-style */
+.section-header {
+    color: #0088FF;
+    letter-spacing: 0.15em;
+}
+
+/* Quote blocks: data stream */
+.quote-block {
+    border-left-color: #0088FF;
+    background: #0A0A0A;
+}
+
+.quote-block:hover {
+    border-left-color: #00FF41;
+    background: #111111;
+}
+
+.quote-content {
+    color: #C0C0C0;
+}
+
+/* Action indicators: pure signal */
+.action-indicator--active {
+    background: #00FF41;
+    box-shadow: 0 0 6px rgba(0, 255, 65, 0.4);
+}
+
+.action-indicator--pending {
+    background: #FF0040;
+    box-shadow: 0 0 6px rgba(255, 0, 64, 0.3);
+}
+
+/* Project status badges */
+.project-status--active {
+    background: rgba(0, 255, 65, 0.1);
+    color: #00FF41;
+}
+
+.project-status--resting {
+    background: rgba(85, 85, 85, 0.2);
+    color: #666666;
+}
+
+/* Footer */
+.footer-zone {
+    border-top-color: #1A1A1A;
+}
+
+.footer-prompt {
+    color: #444444;
+    font-style: normal;
+}
+
+/* Skin switcher: dark chrome */
+.skin-switcher {
+    background: #0A0A0A;
+    border-color: #1A1A1A;
+    border-radius: 4px;
+}
+
+.skin-switcher__pill {
+    border-radius: 2px;
+    color: #555555;
+}
+
+.skin-switcher__pill:hover {
+    color: #00FF41;
+    background: #161616;
+}
+
+.skin-switcher__pill--active {
+    background: #161616;
+    color: #00FF41;
+}
+
+/* Mode value: matrix green */
+.mode-value {
+    color: #00FF41;
+}
