# =============================================================================
# Promaia + zBrain Environment Variables
# Copy this file to .env and fill in your actual values.
# Lines marked [Required] must be set. Others are optional.
# =============================================================================

# =============================================================================
# DATABASE [Required]
# =============================================================================

# Supabase session pooler URL (recommended on all platforms, required on Windows
# to avoid IPv6 routing issues).
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session mode
DATABASE_URL='postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres'

# =============================================================================
# GOOGLE / GEMINI [Required]
# Gemini powers agents, conversation, and embeddings.
# =============================================================================

# Google AI API key.
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY='your_google_api_key'

# Default Gemini model for general queries. Options: pro, flash, 3.0-flash
GOOGLE_DEFAULT_MODEL='pro'

# =============================================================================
# TELEGRAM BOT [Required for mobile access]
# =============================================================================

# Bot token from @BotFather in Telegram.
# Create: open Telegram -> search @BotFather -> /newbot -> follow prompts.
TELEGRAM_BOT_TOKEN='your_telegram_bot_token'

# Comma-separated Telegram chat IDs allowed to use the bot.
# Find yours: send /start to @userinfobot in Telegram.
# All other chat IDs are silently dropped (no response).
TELEGRAM_WHITELIST='comma_separated_chat_ids'

# Webhook mode (cloud deployments only; leave empty for local polling).
# TELEGRAM_WEBHOOK_URL=''

# =============================================================================
# DEEPGRAM [Optional -- voice note transcription]
# =============================================================================

# Deepgram API key for speech-to-text (Nova-3 model, OGG Opus native).
# Get from: https://console.deepgram.com/ -> Settings -> API Keys
# Free tier: $200 credits, no CC required.
# If unset, voice notes return a "not configured" message.
DEEPGRAM_API_KEY='your_deepgram_api_key'

# =============================================================================
# DASHBOARD [Optional -- web dashboard auth]
# =============================================================================

# If DASHBOARD_PASSWORD is not set, auth is disabled (fine for localhost).
DASHBOARD_USERNAME='admin'
DASHBOARD_PASSWORD=''
# Optional: static Bearer token for API access from scripts
# DASHBOARD_AUTH_TOKEN=''
# Optional: secret for signing session cookies (auto-derived from password if unset)
# DASHBOARD_SECRET=''

# =============================================================================
# SERVER [Optional -- web server config]
# =============================================================================

HOST='0.0.0.0'
PORT='8000'
# Set to 'production' on cloud deployments (enables secure cookies, proxy trust)
# PYTHON_ENV='development'

# =============================================================================
# ANTHROPIC [Optional -- only for Claude SDK agent path]
# Not needed for normal operation (agents default to Gemini).
# =============================================================================

ANTHROPIC_API_KEY='your_anthropic_key'

# =============================================================================
# OPENAI [Optional -- only for upstream Promaia features]
# Not used by zBrain modules.
# =============================================================================

OPENAI_API_KEY='your_openai_key'

# =============================================================================
# NOTION [Optional -- agent workspace backend]
# =============================================================================

# Notion integration token for your workspace.
# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN='your_notion_token'

# =============================================================================
# GMAIL [Optional -- email triage agent]
# =============================================================================

# Primary Gmail address for email triage.
GMAIL_PERSONAL_EMAIL='your_email@gmail.com'
# OAuth credentials go in credentials/YOUR_WORKSPACE/ directory.
# See SETUP.md for Gmail OAuth setup instructions.

# =============================================================================
# LOCAL LLAMA [Optional -- Ollama / LM Studio]
# =============================================================================

LLAMA_BASE_URL='http://localhost:11434'
LLAMA_DEFAULT_MODEL='llama3:latest'

# =============================================================================
# OTHER
# =============================================================================

# Debug mode (0=off, 1=on)
MAIA_DEBUG='0'

# Gemini image processing: file size threshold (MB) for File API vs base64
GEMINI_FILE_API_THRESHOLD_MB='20'
