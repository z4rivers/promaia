  "generated_sql": "SELECT DISTINCT\nu.page_id,\nu.title,\nu.created_time,\nu.database_name,\ng.message_content,\ng.subject\nFROM unified_content u\nLEFT JOIN gmail_content g ON u.page_id = g.page_id\nWHERE u.workspace = 'trass' \nAND u.created_time >= datetime('now', '-3 months')\nAND (\n    u.database_name IN ('stories', 'journal', 'cpj')\n    OR LOWER(u.database_name) LIKE '%stories%'\n    OR LOWER(u.database_name) LIKE '%journal%'\n)\nAND (\n    LOWER(u.title) LIKE '%international%'\n    OR LOWER(u.title) LIKE '%launch%'\n    OR LOWER(g.subject) LIKE '%international%' \n    OR LOWER(g.subject) LIKE '%launch%'\n    OR LOWER(g.message_content) LIKE '%international%'\n    OR LOWER(g.message_content) LIKE '%launch%'\n)\nORDER BY u.created_time DESC\nLIMIT 5000;",
