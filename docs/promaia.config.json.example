{
  "global": {
    "default_sync_days": 7,
    "default_output_directory": "data",
    "markdown_base_directory": "data/md",
    "json_base_directory": "data/json",
    "json_registry_db": "data/maia_content.db",
    "vector_search": {
      "enabled": true,
      "embedding_provider": "openai",
      "embedding_model": "text-embedding-3-small",
      "chroma_path": "chroma_db",
      "default_n_results": 20,
      "default_similarity_threshold": 0.75
    },
    "storage_format": "json",
    "enable_ai_editing": true,
    "ai_edit_safety_mode": true
  },
  "databases": {
    "journal": {
      "source_type": "notion",
      "database_id": "YOUR_JOURNAL_DATABASE_ID",
      "nickname": "journal",
      "description": "Personal journal entries",
      "workspace": "koii",
      "sync_enabled": true,
      "include_properties": true,
      "sync_frequency": "daily",
      "default_days": 7,
      "last_sync_time": null,
      "filters": {},
      "property_filters": {},
      "date_filters": {
        "property": "Date",
        "type": "date"
      },
      "output_directory": "data/koii/md/journal",
      "markdown_directory": "data/md/notion/koii/journal",
      "json_directory": "data/json",
      "primary_format": "json",
      "save_markdown": true,
      "save_json": true,
      "save_to_vector_db": false,
      "vector_db_collection": "journal",
      "sync_subpages": true,
      "property_mapping": {},
      "required_properties": [],
      "excluded_properties": [],
      "auth": {}
    },
    "cms": {
      "source_type": "notion",
      "database_id": "YOUR_CMS_DATABASE_ID",
      "nickname": "cms",
      "description": "Content management system",
      "workspace": "koii",
      "sync_enabled": true,
      "include_properties": true,
      "sync_frequency": "daily",
      "default_days": 30,
      "last_sync_time": null,
      "filters": {},
      "property_filters": {},
      "date_filters": {},
      "output_directory": "data/koii/md/cms",
      "markdown_directory": "data/md/notion/koii/cms",
      "json_directory": "data/json",
      "primary_format": "json",
      "save_markdown": true,
      "save_json": true,
      "save_to_vector_db": false,
      "vector_db_collection": "cms",
      "sync_subpages": false,
      "property_mapping": {},
      "required_properties": [],
      "excluded_properties": [],
      "auth": {}
    },
    "gmail_personal": {
      "source_type": "gmail",
      "database_id": "${GMAIL_PERSONAL_EMAIL}",
      "nickname": "gmail_personal",
      "description": "Gmail integration for personal workspace",
      "workspace": "koii",
      "sync_enabled": true,
      "include_properties": true,
      "sync_frequency": "daily",
      "default_days": 7,
      "last_sync_time": null,
      "filters": {},
      "property_filters": {},
      "date_filters": {},
      "output_directory": "data/md/gmail/personal",
      "markdown_directory": "data/md/gmail/personal",
      "json_directory": "data/json",
      "primary_format": "json",
      "save_markdown": true,
      "save_json": false,
      "save_to_vector_db": false,
      "vector_db_collection": "gmail_personal",
      "sync_subpages": false,
      "property_mapping": {},
      "required_properties": [],
      "excluded_properties": [],
      "auth": {}
    }
  },
  "workspaces": {
    "koii": {
      "api_key": "${NOTION_KOII_API_KEY}",
      "description": "Default workspace",
      "enabled": true,
      "created_at": "2025-06-03T14:14:58.274515"
    },
    "business": {
      "api_key": "${NOTION_BUSINESS_API_KEY}",
      "description": "Business workspace",
